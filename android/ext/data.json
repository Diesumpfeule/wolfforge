 "css": {
  "packs": {
   "github": {
    "css": ":root, [data-color-mode], [data-color-mode] * {\n    --bgColor-default: «base» !important; --bgColor-muted: «mantle» !important;\n    --bgColor-inset: «crust» !important; --bgColor-emphasis: «surface2» !important;\n    --bgColor-accent-muted: color-mix(in srgb, «accent» 15%, transparent) !important; --bgColor-accent-emphasis: «accent» !important;\n    --fgColor-default: «text» !important; --fgColor-muted: «subtext» !important;\n    --fgColor-accent: «accent» !important; --fgColor-onEmphasis: «on_accent» !important;\n    --borderColor-default: «surface2» !important; --borderColor-muted: «surface» !important;\n    --borderColor-accent-emphasis: «accent» !important;\n    --button-default-bgColor-rest: «surface» !important; --button-default-bgColor-hover: «surface2» !important;\n    --button-default-fgColor-rest: «text» !important;\n    --header-bgColor: «mantle» !important; --overlay-bgColor: «mantle» !important;\n  }",
    "domains": [
     "github.com"
    ],
    "name": "GitHub"
   },
   "wikipedia": {
    "css": ":root, html.skin-theme-clientpref-night, html.skin-theme-clientpref-os {\n    --background-color-base: «base» !important; --background-color-neutral-subtle: «mantle» !important;\n    --background-color-neutral: «surface» !important; --background-color-interactive-subtle: «mantle» !important;\n    --background-color-interactive: «surface» !important;\n    --color-base: «text» !important; --color-emphasized: «text» !important;\n    --color-subtle: «subtext» !important; --color-placeholder: «overlay» !important;\n    --color-progressive: «accent» !important; --color-progressive--hover: color-mix(in srgb, «accent» 80%, «text») !important;\n    --color-visited: «accent2» !important;\n    --border-color-base: «surface2» !important; --border-color-subtle: «surface» !important;\n    --border-color-muted: «surface» !important;\n  }",
    "domains": [
     "wikipedia.org",
     "wikimedia.org",
     "wiktionary.org"
    ],
    "name": "Wikipedia"
   },
   "youtube": {
    "css": ":root, :root[dark], :root:not([dark]), html[darker-dark-theme], [dark], [system-icons],\n  ytd-app, ytd-masthead, ytd-popup-container, tp-yt-iron-dropdown, ytd-multi-page-menu-renderer {\n    --yt-spec-base-background: «base» !important;\n    --yt-spec-raised-background: «mantle» !important;\n    --yt-spec-menu-background: «mantle» !important;\n    --yt-spec-general-background-a: «base» !important;\n    --yt-spec-general-background-b: «mantle» !important;\n    --yt-spec-general-background-c: «crust» !important;\n    --yt-spec-brand-background-solid: «mantle» !important;\n    --yt-spec-brand-background-primary: «mantle» !important;\n    --yt-spec-snackbar-background: «surface» !important;\n    --yt-spec-badge-chip-background: «surface» !important;\n    --yt-spec-additive-background: color-mix(in srgb, «text» 8%, transparent) !important;\n    --yt-spec-10-percent-layer: «surface2» !important;\n    --yt-spec-outline: «surface2» !important;\n    --yt-spec-text-primary: «text» !important;\n    --yt-spec-text-secondary: «subtext» !important;\n    --yt-spec-text-disabled: «overlay» !important;\n    --yt-spec-icon-active-other: «text» !important;\n    --yt-spec-icon-inactive: «subtext» !important;\n    --yt-spec-call-to-action: «accent» !important;\n    --yt-spec-themed-blue: «accent» !important;\n    --yt-spec-static-brand-red: «accent» !important;\n    --yt-spec-frosted-glass-desktop: color-mix(in srgb, «mantle» 92%, transparent) !important;\n    --yt-frosted-glass-desktop: color-mix(in srgb, «mantle» 92%, transparent) !important;\n    --yt-sys-color-baseline--base-background: «base» !important;\n    --yt-sys-color-baseline--raised-background: «mantle» !important;\n    --yt-sys-color-baseline--menu-background: «mantle» !important;\n    --yt-sys-color-baseline--additive-background: color-mix(in srgb, «text» 8%, transparent) !important;\n    --yt-sys-color-baseline--text-primary: «text» !important;\n    --yt-sys-color-baseline--text-secondary: «subtext» !important;\n    --yt-sys-color-baseline--call-to-action: «accent» !important;\n    --yt-sys-color-baseline--outline: «surface2» !important;\n    --yt-endpoint-color: «text» !important;\n    --ytd-searchbox-background: «crust» !important;\n    --ytd-searchbox-text-color: «text» !important;\n    --ytd-searchbox-border-color: «surface2» !important;\n    --ytd-searchbox-legacy-button-color: «surface» !important;\n    --ytd-searchbox-legacy-button-icon-color: «text» !important;\n    --paper-tooltip-background: «surface» !important;\n    --paper-tooltip-text-color: «text» !important;\n    --iron-icon-fill-color: «text» !important;\n    --primary-text-color: «text» !important;\n    --primary-background-color: «base» !important;\n    --primary-color: «accent» !important;\n    --accent-color: «accent» !important;\n    --divider-color: «surface2» !important;\n  }\n  html, body, ytd-app, ytd-app[is-shorts-page], ytd-browse, ytd-watch-flexy, ytd-search,\n  #page-manager, #columns { background-color: «base» !important; }\n  #background.ytd-masthead, #frosted-glass, #container.ytd-masthead { background: «mantle» !important; }\n  .ytSearchboxComponentInputBox, .ytSearchboxComponentSuggestionsContainer, ytd-searchbox #container,\n  .sbdd_b, .sbsb_a {\n    background-color: «crust» !important; color: «text» !important;\n    border-color: «surface2» !important;\n  }\n  .ytSearchboxComponentInput, ytd-searchbox input { color: «text» !important; }\n  ytd-menu-popup-renderer, .ytContextualSheetLayoutHost, .ytSpecDialogLayoutHost,\n  tp-yt-paper-dialog, ytd-multi-page-menu-renderer {\n    background-color: «mantle» !important; color: «text» !important;\n  }\n  #guide-content, ytd-mini-guide-renderer, tp-yt-app-drawer #contentContainer {\n    background-color: «mantle» !important;\n  }\n  yt-chip-cloud-chip-renderer[selected] #chip-container, .ytChipShapeActive {\n    background-color: «accent» !important; color: «on_accent» !important;\n  }\n  .ytp-play-progress, .ytp-swatch-background-color { background: «accent» !important; }\n  .html5-video-player { background-color: #000 !important; }",
    "domains": [
     "youtube.com"
    ],
    "name": "YouTube"
   }
  },
  "rules": {
   "dim": "html { filter: brightness(0.82) sepia(0.18) !important; }",
   "invert": "html { filter: invert(0.92) hue-rotate(180deg) !important; background-color: #fff !important; }\n  img, video, picture, canvas, iframe, embed, object, svg image,\n  [style*=\"background-image\"] { filter: invert(1) hue-rotate(180deg) !important; }",
   "theme": "html, body { background-color: «base» !important; color: «text» !important; }\n  a, a:visited { color: «accent» !important; }\n  ::selection { background-color: «accent» !important; color: «on_accent» !important; }"
  },
  "touches": {
   "caret": "input, textarea, [contenteditable] { caret-color: «accent»; }",
   "focus_ring": ":focus-visible { outline-color: «accent»; }",
   "scrollbars": ":root { scrollbar-color: color-mix(in srgb, «accent» 65%, «base») transparent; }",
   "selection": "::selection { background-color: «accent»; color: «on_accent»; }"
  }
 },
