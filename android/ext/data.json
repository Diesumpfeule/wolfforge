 "privacy": {
  "comfort": [
   {
    "pref": "media.eme.enabled",
    "value": true,
    "why": "DRM video (Netflix, Spotify web player …)"
   },
   {
    "pref": "privacy.resistFingerprinting",
    "value": false,
    "why": "Sites see a generic device (also forces light mode and UTC time)"
   },
   {
    "pref": "privacy.fingerprintingProtection",
    "value": true,
    "why": "Firefox's lighter fingerprinting protection"
   },
   {
    "pref": "webgl.disabled",
    "value": false,
    "why": "WebGL – off closes a fingerprinting door, some 3D pages stop working"
   }
  ],
  "fortress": [
   {
    "pref": "media.eme.enabled",
    "value": false,
    "why": "DRM video (Netflix, Spotify web player …)"
   },
   {
    "pref": "privacy.resistFingerprinting",
    "value": true,
    "why": "Sites see a generic device (also forces light mode and UTC time)"
   },
   {
    "pref": "privacy.resistFingerprinting.letterboxing",
    "value": true,
    "why": "Page size is rounded so the screen size leaks less"
   },
   {
    "pref": "media.peerconnection.enabled",
    "value": false,
    "why": "WebRTC – off stops IP leaks, but also video calls in the browser"
   },
   {
    "pref": "webgl.disabled",
    "value": true,
    "why": "WebGL – off closes a fingerprinting door, some 3D pages stop working"
   },
   {
    "pref": "network.http.referer.XOriginPolicy",
    "value": 2,
    "why": "Tell other sites where you came from: 2 = only the same host"
   },
   {
    "pref": "network.http.referer.XOriginTrimmingPolicy",
    "value": 2,
    "why": "How much of the address other sites get: 2 = only the host"
   },
   {
    "pref": "pdfjs.enableScripting",
    "value": false,
    "why": "Scripts inside PDF files"
   },
   {
    "pref": "dom.security.https_only_mode",
    "value": true,
    "why": "Only open encrypted (https) pages"
   }
  ]
 },
