<!doctype html>
<!-- {{ mark }} – rebuilt by `wolfforge apply` -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root {
  --crust: {{ c.crust }}; --mantle: {{ c.mantle }}; --base: {{ c.base }}; --surface: {{ c.surface }};
  --surface2: {{ c.surface2 }}; --overlay: {{ c.overlay }}; --text: {{ c.text }}; --subtext: {{ c.subtext }};
  --accent: {{ c.accent }}; --accent2: {{ c.accent2 }}; --shade: {{ mix(c.accent, c.base, 0.5) }};
  --on-accent: {{ on_accent }}; --r: {{ radius }}px;
  color-scheme: {{ "dark" if p.dark else "light" }};
}
* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; background: var(--base); color: var(--text);
  font: {{ font_size + 1 }}px/1.45 "{{ font }}", ui-monospace, monospace; }
body { display: flex; justify-content: center; padding: 6vh 24px 40px; }
main { width: min(1100px, 100%); }
pre { margin: 0; font: inherit; line-height: 1.12; white-space: pre; }
.two .s { color: var(--shade); } .two .f { color: var(--accent); }
.banner { font-size: {{ font_size - 1 }}px; font-weight: bold; text-align: center; margin-bottom: 26px; overflow: hidden; }
.banner pre { display: inline-block; text-align: left; }
.hero { display: flex; gap: 36px; align-items: center; justify-content: center; flex-wrap: wrap; margin-bottom: 30px; }
.art { font-size: {{ font_size - 2 }}px; }
.side { flex: 1 1 360px; max-width: 560px; }
.clock { font-size: 34px; font-weight: bold; color: var(--accent); letter-spacing: 2px; }
.date { color: var(--subtext); margin-bottom: 14px; }
form { display: flex; gap: 8px; }
input[type=search] { flex: 1; font: inherit; color: var(--text); background: var(--surface);
  border: 1px solid var(--surface2); border-radius: var(--r); padding: 10px 14px; outline: none; }
input[type=search]:focus { border-color: var(--accent); background: var(--crust); }
button { font: inherit; font-weight: bold; color: var(--on-accent); background: var(--accent); border: none;
  border-radius: var(--r); padding: 0 18px; cursor: pointer; }
.hint { color: var(--overlay); font-size: 12px; margin-top: 8px; }
.groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
.group { background: var(--mantle); border: 1px solid var(--surface2); border-radius: var(--r); padding: 12px 14px; }
.group h2 { margin: 0 0 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: var(--accent); }
.group a { display: block; color: var(--text); text-decoration: none; padding: 2px 4px; border-radius: var(--r);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.group a:hover, .group a:focus { background: var(--accent); color: var(--on-accent); outline: none; }
.group a .k { color: var(--overlay); margin-right: 6px; }
.group a:hover .k, .group a:focus .k { color: var(--on-accent); }
footer { margin-top: 26px; text-align: center; color: var(--overlay); font-size: 12px; }
{% if layout == "win98" %}
.window { border: 2px solid; border-color: {{ bv.hi }} {{ bv.lo }} {{ bv.lo }} {{ bv.hi }}; background: {{ bv.face }}; }
.window .titlebar { background: linear-gradient(to right, {{ bv.title }}, {{ bv.title2 }}); color: var(--on-accent);
  font-weight: bold; padding: 3px 6px; display: flex; justify-content: space-between; }
.window .titlebar span:last-child { letter-spacing: 4px; }
.window .inner { padding: 22px; }
.group { border: 2px solid; border-color: {{ bv.lo }} {{ bv.hi }} {{ bv.hi }} {{ bv.lo }}; border-radius: 0; background: var(--crust); }
input[type=search] { border: 2px solid; border-color: {{ bv.lo }} {{ bv.hi }} {{ bv.hi }} {{ bv.lo }}; border-radius: 0; }
button { border: 2px solid; border-color: {{ bv.hi }} {{ bv.lo }} {{ bv.lo }} {{ bv.hi }}; border-radius: 0;
  background: {{ bv.face }}; color: var(--text); }
button:active { border-color: {{ bv.lo }} {{ bv.hi }} {{ bv.hi }} {{ bv.lo }}; }
{% elif layout == "wired" %}
body { background-image: repeating-linear-gradient(to bottom, transparent 0 2px, {{ rgba(c.accent, 0.04) }} 2px 3px); }
.group { background: transparent; border-color: var(--accent); border-radius: 0; }
.group h2::before { content: "[ "; } .group h2::after { content: " ]"; }
.group a::before { content: "> "; color: var(--overlay); }
input[type=search] { border-radius: 0; border-color: var(--accent); background: transparent; }
button { border-radius: 0; background: transparent; color: var(--accent); border: 1px solid var(--accent); }
.clock::after { content: "_"; animation: blink 1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }
{% endif %}
</style>
</head>
<body>
<main>
{% if layout == "win98" %}<div class="window"><div class="titlebar"><span>{{ title }}</span><span>_ □ x</span></div><div class="inner">{% endif %}
  <div class="banner two"><pre>{{ banner_html }}</pre></div>
  <section class="hero">
    <pre class="art two">{{ art_html }}</pre>
    <div class="side">
{% if sp.clock %}      <div class="clock" id="clock">--:--</div>
      <div class="date" id="date"></div>
{% endif %}
      <form action="{{ search_url }}" method="get" role="search">
        <input type="search" name="{{ search_param }}" id="q" placeholder="search {{ search_name }} …" autocomplete="off" autofocus>
{% for k, v in ddg.items() %}        <input type="hidden" name="{{ k }}" value="{{ v | e }}">
{% endfor %}
        <button type="submit">go</button>
      </form>
      <div class="hint">type anywhere to search · 1-9 open the first links · esc clears</div>
    </div>
  </section>
{% if sp.bookmarks and groups %}
  <section class="groups">
{% for name, links in groups %}
    <div class="group"><h2>{{ name }}</h2>
{% for b in links %}      <a href="{{ b.url }}" title="{{ b.url }}"{% if b.n %} data-n="{{ b.n }}"{% endif %}>{% if b.n %}<span class="k">{{ b.n }}</span>{% endif %}{{ b.title }}</a>
{% endfor %}    </div>
{% endfor %}
  </section>
{% endif %}
  <footer>{{ p.label }} · {{ layout }} · wolfforge</footer>
{% if layout == "win98" %}</div></div>{% endif %}
</main>
<script>
const q = document.getElementById("q");
function tick() {
  const c = document.getElementById("clock"); if (!c) return;
  const d = new Date();
  c.textContent = d.toLocaleTimeString([], {hour: "2-digit", minute: "2-digit"});
  document.getElementById("date").textContent = d.toLocaleDateString([], {weekday: "long", day: "numeric", month: "long"});
}
tick(); setInterval(tick, 10000);
document.addEventListener("keydown", e => {
  if (e.ctrlKey || e.altKey || e.metaKey) return;
  if (e.key === "Escape") { q.value = ""; q.blur(); return; }
  if (document.activeElement !== q && /^[1-9]$/.test(e.key)) {
    const a = document.querySelector(`a[data-n="${e.key}"]`); if (a) { location.href = a.href; e.preventDefault(); }
    return;
  }
  if (document.activeElement !== q && e.key.length === 1) q.focus();
});
</script>
</body>
</html>
