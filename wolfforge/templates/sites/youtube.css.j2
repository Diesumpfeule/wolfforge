    --yt-frosted-glass-desktop: {{ rgba(c.mantle, 0.92) }} !important;
    --yt-sys-color-baseline--base-background: {{ c.base }} !important;
    --yt-sys-color-baseline--raised-background: {{ c.mantle }} !important;
    --yt-sys-color-baseline--menu-background: {{ c.mantle }} !important;
    --yt-sys-color-baseline--additive-background: {{ rgba(c.text, 0.08) }} !important;
    --yt-sys-color-baseline--text-primary: {{ c.text }} !important;
    --yt-sys-color-baseline--text-secondary: {{ c.subtext }} !important;
